PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

ADMIN_NAME="Md. Samim"
ADMIN_EMAIL="tamjidulislamsamim@gmail.com"
ADMIN_PASSWORD="your_admin_password"

CLIENT_URL="http://localhost:5173"
SERVER_URL="https://your-portfolio-backend.onrender.com"

# Keep-Alive & Anti-Cold-Start Cron Configuration
# Runs every 10 minutes to prevent Neon DB suspension and Render idle sleep
CRON_ENABLED=true
CRON_SCHEDULE="*/10 * * * *"
