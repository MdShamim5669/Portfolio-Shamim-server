{
  "name": "samim-portfolio-server",
  "version": "1.0.0",
  "description": "Express.js + Prisma ORM + PostgreSQL Backend API for Md. Samim's Portfolio",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "npx prisma generate",
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/sqa.test.js",
    "seed": "node prisma/seed.js",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "open-graph-scraper": "^6.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0"
  }
}
